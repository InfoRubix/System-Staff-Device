rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is super admin
    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Users collection - users can read their own data, admins can read/write all
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn();
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }

    // Devices collection - users can only READ their own, desktop app creates/updates via API key
    match /devices/{deviceId} {
      // Users can read their own device, admins can read all
      allow read: if isSignedIn() && (
        request.auth.token.email == resource.data.staffEmail || isAdmin()
      );

      // Allow create/update for anyone (desktop app uses REST API with API key)
      // Note: REST API with API key doesn't bypass rules, so we allow unauthenticated writes
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Device health collection - authenticated users can read, only admins can write
    match /device_health/{healthId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Repairs collection - authenticated users can read, only admins can manage
    match /repairs/{repairId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Any user can create repair request
      allow update, delete: if isAdmin();
    }

    // Staff collection - allow create/update for desktop app via API key
    match /staff/{staffId} {
      allow read: if isAdmin();
      // Allow create/update for anyone (desktop app uses REST API with API key)
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Departments collection - PUBLIC READ for signup page, admin write
    match /departments/{departmentId} {
      allow read: if true; // PUBLIC READ - anyone can read departments (needed for signup dropdown)
      allow write: if isAdmin();
    }

    // System logs - only admins can read/write
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Device scans collection - devices can write with valid token, users can read their own
    match /device_scans/{scanId} {
      allow read: if isSignedIn();
      // Allow create for anyone (desktop app uses REST API with API key)
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // App downloads tracking - authenticated users can write their own, admins can read all
    match /app_downloads/{downloadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Notifications collection - authenticated users can read, admins can write
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Repair remarks collection - only admins can read/write remarks
    match /repair_remarks/{remarkId} {
      allow read, write: if isAdmin();
    }

    // Assigned repairs collection - admins can write, technicians can read/update their own
    match /assigned_repairs/{repairId} {
      allow read, update: if isSignedIn() && (
        request.auth.token.email == resource.data.technicianEmail ||
        isAdmin()
      );
      allow create, delete: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}